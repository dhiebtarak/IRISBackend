{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Jwt": {
    "Issuer": "IRISBackend",
    "Audience": "IRISFrontend",
    "SigningKey": "IRISBackendDevelopmentSigningKey_ChangeThisForProduction",
    "ExpirationMinutes": 60
  },
  "ConnectionStrings": {
    "DevDB": "Server=(localdb)\\MSSQLLocalDB;Database=IRISBackend;TrustServerCertificate=True;MultipleActiveResultSets=True;"
  },
  "CounterpartyAttachments": {
