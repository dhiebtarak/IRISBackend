    "AllowedExtensions": [ ".pdf", ".png", ".jpg", ".jpeg" ]
  },
  "DocumentStorage": {
    "RootPath": "App_Data/Documents",
    "MaxFileSizeBytes": 10485760,
    "AllowedExtensions": [ ".pdf", ".doc", ".docx", ".xls", ".xlsx", ".png", ".jpg", ".jpeg", ".txt", ".csv" ]
  },
  "IrisInvoiceBranding": {
