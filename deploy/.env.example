# Copy to .env on the hosting PC and protect it (chmod 600). Never commit the populated file.
DB_NAME=IRISBackend
DB_USER=iris_app
MSSQL_PID=Developer
DB_PASSWORD=replace-with-generated-base64url-password
MSSQL_SA_PASSWORD=replace-with-generated-base64url-password
JWT_ISSUER=IRISBackend
JWT_AUDIENCE=IRISFrontend
JWT_SIGNING_KEY=replace-with-at-least-32-random-bytes

# Bootstrap is one-shot: remove these entries after running bootstrap-admin.
IRIS_BOOTSTRAP_ADMIN_EMAIL=deployment-admin@example.invalid
IRIS_BOOTSTRAP_ADMIN_PASSWORD=replace-with-one-time-strong-password
IRIS_BOOTSTRAP_ADMIN_FULL_NAME=Deployment Administrator

# Supply actual values through the hosting machine's protected .env, never source control.
IRIS_BANK_0_ACCOUNT_HOLDER=replace
IRIS_BANK_0_NAME=replace
IRIS_BANK_0_CURRENCY=TND
IRIS_BANK_0_RIB=replace
IRIS_BANK_0_IBAN=replace
IRIS_BANK_0_SWIFT_BIC=replace
IRIS_BANK_0_DOMICILIATION=replace
IRIS_BANK_1_ACCOUNT_HOLDER=replace
IRIS_BANK_1_NAME=replace
IRIS_BANK_1_CURRENCY=USD
IRIS_BANK_1_RIB=replace
IRIS_BANK_1_IBAN=replace
IRIS_BANK_1_SWIFT_BIC=replace
IRIS_BANK_1_DOMICILIATION=replace
IRIS_BANK_2_ACCOUNT_HOLDER=replace
IRIS_BANK_2_NAME=replace
IRIS_BANK_2_CURRENCY=EUR
IRIS_BANK_2_RIB=replace
IRIS_BANK_2_IBAN=replace
IRIS_BANK_2_SWIFT_BIC=replace
IRIS_BANK_2_DOMICILIATION=replace
